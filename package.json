{
  "name": "@agentropolis/sentinel-6",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Multi-model adversarial assurance runtime for the AGENTROPOLIS Intelligence Grid",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sentinel-6": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "validate:policies": "node dist/src/cli.js validate policies",
    "assert:validator": "node scripts/assert-validator-ran.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
